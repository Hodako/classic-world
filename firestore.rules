rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function parentAccount() {
      return request.auth != null
        && !('pos_employee' in request.auth.token)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.firebase.sign_in_provider != 'custom';
    }
    match /employees/{employeeId} {
      // Legacy PIN login currently queries employee records. Ownership writes are protected.
      allow read: if true;
      allow create: if parentAccount() && request.resource.data.owner_uid == request.auth.uid;
      allow update: if (
        !('owner_uid' in resource.data) && !('owner_uid' in request.resource.data)
      ) || (parentAccount() && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == resource.data.owner_uid);
      allow delete: if !('owner_uid' in resource.data)
        || (parentAccount() && resource.data.owner_uid == request.auth.uid);
    }
    match /employee_device_codes/{code} {
      allow read, write: if true;
    }

    // Pairing records and rate limits are only accessed by the Admin SDK.
    match /{collection}/{document=**} {
      allow read, write: if !(collection in [
        'employee_link_codes', 'employee_link_current',
        'employee_link_limits', 'employee_linked_devices', 'employees'
      ]);
    }
  }
}
